# Copia este archivo como .env.local y completa los valores.
# .env.local no se sube a GitHub.

# Configuración web de Firebase (consola de Firebase > Configuración del proyecto > Tus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Carpeta de Obsidian de donde `npm run blog` toma las notas con `publicar: true`.
BLOG_VAULT_PATH=
